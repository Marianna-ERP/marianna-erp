{
  "name": "freshtrade-erp",
  "version": "6.65.0",
  "private": true,
  "dependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "build:vercel": "CI=false react-scripts build",
    "typecheck": "tsc --noEmit",
    "verify": "tsc --noEmit && CI=true react-scripts build",
    "test:engines": "tsc -p tests/tsconfig.json && node tests/run-engines.cjs",
    "test:matrix": "tsc -p tests/tsconfig.json && node tests/phase3-matrix.cjs",
    "test:all": "tsc -p tests/tsconfig.json && node tests/run-engines.cjs && node tests/audit-roundtrip.cjs && node tests/phase3-matrix.cjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "engines": {
    "node": "24.x"
  }
}